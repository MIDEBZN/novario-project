---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/services', label: 'Services' },
  { href: '/locations', label: 'Zones d\'intervention' },
  { href: '/about', label: 'À propos' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="site-header">
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-item">
        <span class="live-indicator"></span>
        <span class="top-text">Permanence technique active: Dépannage Wallonie et Bruxelles</span>
      </div>
      <div class="top-bar-contact">
        <span class="top-meta">Agrément Cerga Gaz et PEB</span>
        <span class="top-divider">|</span>
        <a href="tel:+3228994321" class="top-phone">
          <svg class="icon-inline" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          +32 2 899 43 21
        </a>
      </div>
    </div>
  </div>

  <div class="main-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo" aria-label="Novario Project Accueil">
        <div class="logo-mark">
          <svg width="28" height="28" viewBox="0 0 48 48" fill="none">
            <rect width="48" height="48" rx="8" fill="#131b27" stroke="rgba(255,255,255,0.15)"/>
            <path d="M12 36V12L24 24V36" stroke="#c2612d" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M24 12V24L36 36V12" stroke="#f8fafc" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="24" cy="24" r="3" fill="#c2612d"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">NOVARIO <span class="brand-accent">PROJECT</span></span>
          <span class="brand-tagline">Plomberie et Chauffage Belgique</span>
        </div>
      </a>

      <nav class="nav-desktop" aria-label="Navigation principale">
        <ul class="nav-list">
          {navLinks.map((link) => (
            <li class="nav-item">
              <a
                href={link.href}
                class:list={['nav-link', { active: isActive(link.href) }]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-actions">
        <a href="tel:+32470123456" class="btn btn-emergency btn-sm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Urgence 24/7
        </a>
        <a href="/contact" class="btn btn-primary btn-sm">
          Devis Gratuit
        </a>
        <button id="mobileMenuBtn" class="mobile-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobileDrawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-content">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['mobile-nav-link', { active: isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-drawer-footer">
        <a href="tel:+32470123456" class="btn btn-emergency" style="width: 100%;">
          Dépannage d'urgence 24/7
        </a>
        <a href="/contact" class="btn btn-primary" style="width: 100%;">
          Demander un devis en ligne
        </a>
        <p class="mobile-info">Intervention rapide en Région bruxelloise et en Wallonie</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(11, 15, 23, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .top-bar {
    background-color: #070a10;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.78rem;
    padding: 0.4rem 0;
    color: var(--text-muted);
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-bar-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .live-indicator {
    width: 6px;
    height: 6px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
  }

  .top-bar-contact {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .top-divider {
    color: rgba(255, 255, 255, 0.2);
  }

  .top-phone {
    color: var(--text-main);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .top-phone:hover {
    color: var(--copper-light);
  }

  .main-header {
    padding: 0.85rem 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #ffffff;
    line-height: 1.1;
  }

  .brand-accent {
    color: var(--copper-light);
  }

  .brand-tagline {
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .nav-desktop {
    display: block;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.04);
  }

  .nav-link.active {
    color: #ffffff;
    font-weight: 600;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 6px;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: #ffffff;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-medium);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    color: var(--text-main);
    border-radius: var(--radius-sm);
    background-color: var(--bg-tertiary);
  }

  .mobile-nav-link.active {
    background-color: var(--copper);
    color: #ffffff;
    font-weight: 600;
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-info {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .nav-desktop {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .top-bar-item .top-text {
      max-width: 220px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .top-meta {
      display: none;
    }
    .top-divider {
      display: none;
    }
  }

  @media (max-width: 500px) {
    .header-actions .btn-primary {
      display: none;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      drawer.setAttribute('aria-hidden', String(!isOpen));
    });
  }
</script>
