---

<div class="zone-search-wrapper" id="zoneSearchSection">
  <div class="search-controls">
    <div class="search-input-box">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        id="zoneInput"
        class="zone-text-input"
        placeholder="Rechercher une commune ou un code postal (ex: 1050, Waterloo, Namur, 4000...)"
        aria-label="Rechercher une commune ou un code postal en Belgique"
      />
      <button type="button" id="clearZoneSearch" class="clear-search-btn" style="display: none;" aria-label="Effacer">×</button>
    </div>

    <div class="region-tabs" role="tablist">
      <button type="button" class="tab-btn active" data-filter="all">Toutes les zones</button>
      <button type="button" class="tab-btn" data-filter="bruxelles">Bruxelles</button>
      <button type="button" class="tab-btn" data-filter="brabant-wallon">Brabant Wallon</button>
      <button type="button" class="tab-btn" data-filter="namur">Namur</button>
      <button type="button" class="tab-btn" data-filter="liege">Liège</button>
      <button type="button" class="tab-btn" data-filter="hainaut">Hainaut</button>
    </div>
  </div>

  <div class="search-summary">
    <span id="zoneCountText">Affichage de {zones.length} localités couvertes</span>
    <span class="delivery-standard">Délai moyen d'astreinte constaté: 35 à 50 minutes</span>
  </div>

  <div class="zones-table-container">
    <div class="zones-grid" id="zonesList">
      {zones.map((zone) => (
        <div
          class="zone-card"
          data-postal={zone.postal}
          data-name={zone.name.toLowerCase()}
          data-region={zone.region}
        >
          <div class="zone-top">
            <span class="zone-postal">{zone.postal}</span>
            <span class="zone-status">
              <span class="pulse-dot"></span>
              {zone.status}
            </span>
          </div>
          <div class="zone-city">{zone.name}</div>
          <div class="zone-bottom">
            <span class="zone-delay-label">Délai d'intervention:</span>
            <span class="zone-delay-val">{zone.delay}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="noResultsMsg" class="no-results" style="display: none;">
    <p>Aucune localité ne correspond exactement à votre recherche.</p>
    <p class="text-sm">Notre équipe dessert également les communes limitrophes sur simple appel téléphonique au <strong>+32 2 899 43 21</strong>.</p>
  </div>
</div>

<style>
  .zone-search-wrapper {
    background-color: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    padding: 2.25rem;
    box-shadow: var(--shadow-md);
  }

  .search-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .search-input-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .zone-text-input {
    width: 100%;
    padding: 1rem 3rem 1rem 3.2rem;
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: 1rem;
    transition: all var(--transition-fast);
  }

  .zone-text-input:focus {
    outline: none;
    border-color: var(--copper);
    background-color: var(--bg-secondary);
  }

  .clear-search-btn {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .region-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tab-btn {
    padding: 0.5rem 1rem;
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tab-btn:hover {
    color: #ffffff;
    border-color: var(--border-medium);
  }

  .tab-btn.active {
    background-color: var(--copper);
    color: #ffffff;
    border-color: var(--copper);
  }

  .search-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .delivery-standard {
    color: var(--copper-light);
    font-weight: 500;
  }

  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .zone-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--transition-fast);
  }

  .zone-card:hover {
    border-color: var(--border-medium);
    transform: translateY(-2px);
    background-color: var(--bg-card-hover);
  }

  .zone-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .zone-postal {
    font-family: monospace;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--copper-light);
    letter-spacing: 0.05em;
  }

  .zone-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #6ee7b7;
    font-weight: 600;
  }

  .zone-city {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .zone-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .zone-delay-label {
    color: var(--text-subtle);
  }

  .zone-delay-val {
    color: var(--text-main);
    font-weight: 600;
  }

  .no-results {
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
  }

  .no-results p {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 600px) {
    .zone-search-wrapper {
      padding: 1.5rem;
    }
    .search-summary {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>

<script>
  function setupZoneSearch() {
    const input = document.getElementById('zoneInput') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clearZoneSearch') as HTMLButtonElement | null;
    const tabBtns = document.querySelectorAll('.tab-btn');
    const cards = document.querySelectorAll('.zone-card');
    const countDisplay = document.getElementById('zoneCountText');
    const noResults = document.getElementById('noResultsMsg');

    if (!input || !cards.length) return;

    let activeFilter = 'all';

    function filterZones() {
      const query = (input?.value || '').trim().toLowerCase();
      if (clearBtn) {
        clearBtn.style.display = query ? 'block' : 'none';
      }

      let visibleCount = 0;

      cards.forEach((cardEl) => {
        const el = cardEl as HTMLElement;
        const postal = el.getAttribute('data-postal') || '';
        const name = el.getAttribute('data-name') || '';
        const region = el.getAttribute('data-region') || '';

        const matchesQuery = !query || postal.includes(query) || name.includes(query);
        const matchesRegion = activeFilter === 'all' || region === activeFilter;

        if (matchesQuery && matchesRegion) {
          el.style.display = 'flex';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.textContent = `Affichage de ${visibleCount} localités couvertes`;
      }

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    input.addEventListener('input', filterZones);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        filterZones();
        input.focus();
      });
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilter = btn.getAttribute('data-filter') || 'all';
        filterZones();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupZoneSearch);
  setupZoneSearch();
</script>
