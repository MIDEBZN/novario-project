---
---

<div class="calculator-panel" id="estimateur">
  <div class="calc-header">
    <div class="calc-header-badge">
      <span class="badge badge-copper">Transparence Tarifaire</span>
    </div>
    <h3 class="calc-title">Simulateur de Devis en Ligne</h3>
    <p class="calc-subtitle">
      Estimation immédiate selon le barème officiel Novario Project et la réglementation fiscale belge (TVA 6% ou 21%).
    </p>
  </div>

  <div class="calc-body">
    <div class="calc-fields">
      <div class="form-group">
        <label for="calcService" class="form-label">Type d'intervention requise</label>
        <select id="calcService" class="form-select">
          <option value="depannage" data-min="95" data-max="175">Dépannage fuite d'eau ou robinetterie</option>
          <option value="debouchage" data-min="130" data-max="220">Débouchage canalisation ou WC par hydrocurage</option>
          <option value="recherche" data-min="240" data-max="380">Recherche de fuite thermique non destructive (Agréé assurance)</option>
          <option value="chaudiere" data-min="145" data-max="195">Entretien annuel chaudière gaz avec attestation PEB</option>
          <option value="boiler" data-min="690" data-max="1250">Remplacement boiler électrique ou thermodynamique</option>
          <option value="renovation" data-min="3800" data-max="8500">Rénovation complète plomberie et sanitaire</option>
        </select>
      </div>

      <div class="calc-grid-row">
        <div class="form-group">
          <label for="calcSlot" class="form-label">Créneau d'intervention</label>
          <select id="calcSlot" class="form-select">
            <option value="normal" data-mult="1.0">En semaine (8h00 à 18h30)</option>
            <option value="soir" data-mult="1.3">Soirée ou Samedi (Astreinte +30%)</option>
            <option value="nuit" data-mult="1.6">Nuit ou Dimanche (Urgence critique +60%)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="calcTax" class="form-label">Régime fiscal belge (TVA)</label>
          <select id="calcTax" class="form-select">
            <option value="0.06">Logement de plus de 10 ans (TVA réduite 6%)</option>
            <option value="0.21">Logement neuf ou commercial (TVA standard 21%)</option>
          </select>
        </div>
      </div>

      <div class="calc-note">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2612d" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span>
          Déplacement inclus dans les 19 communes de Bruxelles et le Brabant Wallon. Facture conforme pour remboursement par votre assurance habitation en cas de sinistre des eaux.
        </span>
      </div>
    </div>

    <div class="calc-result-box">
      <div class="result-label">Fourchette estimée TTC</div>
      <div class="result-price" id="calcPriceDisplay">101 € à 186 €</div>
      <div class="result-tax-detail" id="calcTaxDetail">Inclut TVA belge de 6% et garantie pièces 2 ans</div>
      
      <div class="result-features">
        <div class="res-feature">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Devis écrit validé avant tout démarrage
        </div>
        <div class="res-feature">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Rapport technique avec photos pour assurance
        </div>
        <div class="res-feature">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Matériel certifié marques professionnelles
        </div>
      </div>

      <a href="/contact" class="btn btn-primary" style="width: 100%; margin-top: 1.25rem;">
        Confirmer cette intervention
      </a>
    </div>
  </div>
</div>

<style>
  .calculator-panel {
    background: linear-gradient(180deg, #121924 0%, #0d131d 100%);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-lg);
  }

  .calc-header {
    margin-bottom: 2rem;
  }

  .calc-header-badge {
    margin-bottom: 0.75rem;
  }

  .calc-title {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .calc-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .calc-body {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .calc-grid-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .calc-note {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.9rem;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .calc-note svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .calc-result-box {
    background-color: #17212f;
    border: 1px solid var(--border-copper);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    position: relative;
  }

  .result-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .result-price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .result-tax-detail {
    font-size: 0.78rem;
    color: var(--copper-light);
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .result-features {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-align: left;
    font-size: 0.85rem;
    color: var(--text-main);
  }

  .res-feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 900px) {
    .calc-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .calculator-panel {
      padding: 1.75rem;
    }
  }

  @media (max-width: 550px) {
    .calc-grid-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupCalculator() {
    const serviceSelect = document.getElementById('calcService') as HTMLSelectElement | null;
    const slotSelect = document.getElementById('calcSlot') as HTMLSelectElement | null;
    const taxSelect = document.getElementById('calcTax') as HTMLSelectElement | null;
    const priceDisplay = document.getElementById('calcPriceDisplay');
    const taxDetail = document.getElementById('calcTaxDetail');

    if (!serviceSelect || !slotSelect || !taxSelect || !priceDisplay || !taxDetail) return;

    function recalculate() {
      const selectedService = serviceSelect!.options[serviceSelect!.selectedIndex];
      const minBase = parseFloat(selectedService.getAttribute('data-min') || '100');
      const maxBase = parseFloat(selectedService.getAttribute('data-max') || '200');

      const selectedSlot = slotSelect!.options[slotSelect!.selectedIndex];
      const slotMultiplier = parseFloat(selectedSlot.getAttribute('data-mult') || '1.0');

      const taxRate = parseFloat(taxSelect!.value || '0.06');

      const minTotal = Math.round(minBase * slotMultiplier * (1 + taxRate));
      const maxTotal = Math.round(maxBase * slotMultiplier * (1 + taxRate));

      priceDisplay!.textContent = `${minTotal} € à ${maxTotal} €`;
      const taxPercent = Math.round(taxRate * 100);
      taxDetail!.textContent = `Inclut TVA belge de ${taxPercent}% et garantie légale pièces et main d'œuvre`;
    }

    serviceSelect.addEventListener('change', recalculate);
    slotSelect.addEventListener('change', recalculate);
    taxSelect.addEventListener('change', recalculate);
    recalculate();
  }

  document.addEventListener('DOMContentLoaded', setupCalculator);
  setupCalculator();
</script>
